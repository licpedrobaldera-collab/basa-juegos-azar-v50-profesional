def calcular_avance(cid):
    dbp=get_db_path(cid)
    conn=sqlite3.connect(str(dbp))
    c=conn.cursor()
    try:
        c.execute("SELECT COUNT(*), SUM(CASE WHEN estado LIKE 'Validado%' THEN 1 ELSE 0 END) FROM documentos_ley8626 WHERE solicitante_id=?", (cid,))
        total, validados=c.fetchone()
        conn.close()
        if total==0 or total is None: return 0
        return int((validados or 0)*100/total)
    except:
        conn.close()
        return 0


    conn=sqlite3.connect(str(dbp))
    c=conn.cursor()
    c.execute("CREATE TABLE IF NOT EXISTS solicitantes (id TEXT PRIMARY KEY, nombre TEXT, rnc_cedula TEXT, email TEXT, telefono TEXT, direccion TEXT, tipo_establecimiento TEXT, vigencia TEXT, articulos_ley TEXT, porcentaje_avance INTEGER, estado TEXT, fecha_solicitud TEXT, usuario_id TEXT, clave_hash TEXT, fecha_vencimiento_licencia TEXT, latitud REAL, longitud REAL, ip_licencia_red TEXT)")
    c.execute("CREATE TABLE IF NOT EXISTS documentos_ley8626 (id TEXT PRIMARY KEY, solicitante_id TEXT, nombre_documento TEXT, articulo_ley TEXT, obligatorio INTEGER, estado TEXT, archivo_path TEXT, fecha_subida TEXT, validado_por TEXT, fecha_validacion TEXT, observaciones TEXT, porcentaje INTEGER)")
    c.execute("CREATE TABLE IF NOT EXISTS contratos_intermediacion (id TEXT PRIMARY KEY, solicitante_id TEXT, tipo_contrato TEXT, estado TEXT, archivo_contrato_path TEXT, firma_electronica TEXT, fecha_firma TEXT, firma_digital_path TEXT, validado_hacienda TEXT, validado_cliente TEXT)")

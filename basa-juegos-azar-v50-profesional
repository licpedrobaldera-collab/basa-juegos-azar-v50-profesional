def get_db_path(cid):
    cf=CASOS_DIR/cid
    cf.mkdir(exist_ok=True, parents=True)
    (cf/"documentos").mkdir(exist_ok=True, parents=True)
    (cf/"contratos").mkdir(exist_ok=True, parents=True)
    (cf/"levantamiento").mkdir(exist_ok=True, parents=True)
    (cf/"comprobantes").mkdir(exist_ok=True, parents=True)
    return cf/f"BASA_JUEGO_{cid}_V50.db"

